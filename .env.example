# Required: create at https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=replace-with-your-runpod-key

# Required until the project image is published to a registry.
# Example after the included GitHub workflow builds it:
INDEXTTS_IMAGE=ghcr.io/your-github-name/indextts-cloud:latest

# Intentionally simple for this personal endpoint.
INDEXTTS_API_KEY=sk-1234notsecure

# Optional overrides:
# RUNPOD_GPU_TYPES=NVIDIA GeForce RTX 4090,NVIDIA GeForce RTX 3090,NVIDIA RTX A5000
# RUNPOD_CLOUD_TYPE=SECURE
# RUNPOD_CONTAINER_GB=50
# RUNPOD_VOLUME_GB=50
# RUNPOD_NETWORK_VOLUME_ID=
